{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Start",
            "runtimeExecutable": "yarn", // Use Yarn to run the script
            "runtimeArgs": [
                "start"
            ], // This runs your "start" script
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Config",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "run",
                "config"
            ], // Reference the `update_config` script
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Build",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "build"
            ], // Reference the `update_config` script
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            "name": "Debug Jest Tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "test",
                "--runInBand",
                "--no-cache",
                "--watchAll=false"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_ENV": "test"
            }
        },
        {
            "name": "Debug Current Jest Test",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "test",
                "--runInBand",
                "--no-cache",
                "--watchAll=false",
                "--testNamePattern=${input:testName}",
                "--verbose"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_ENV": "test"
            }
        },
        {
            "name": "Debug Jest Test File",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "test",
                "--runInBand",
                "--no-cache",
                "--watchAll=false",
                "${relativeFile}"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "NODE_ENV": "test"
            }
        },
        {
            "name": "Python: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.app.main:app",
                "--reload"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Scraper Manual Test",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "test:scraper-manual"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development"
            }
        }
    ],
    "inputs": [
        {
            "id": "testName",
            "description": "Test name pattern",
            "default": "",
            "type": "promptString"
        }
    ]
}