{
    "name": "actual-updater-dev",
    "dockerComposeFile": "docker-compose.yaml",
    "workspaceFolder": "/workspaces/actual-updater",
    "service": "dev",
    "runServices": [
        "chromium",
        "dev"
    ],
    "forwardPorts": [
        5006,
        9091
    ],
    "containerEnv": {
        "TZ": "Asia/Jerusalem"
    },
    "mounts": [
        // bind preinstalled node_modules to avoid reinstalling them
        "source=actual-updater-node_modules,target=/workspaces/actual-updater/node_modules,type=volume"
    ],
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "postAttachCommand": "supervisorctl status",
    "shutdownAction": "stopCompose",
    "overrideCommand": false,
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python",
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-python.black-formatter",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.pylint",
                "Orta.vscode-jest"
            ]
        }
    }
}